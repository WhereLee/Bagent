# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# Env / secrets
.env
*.local

# Local model weights (HF cache target — kept off C drive, but not committed)
models/*
!models/.gitkeep

# Data corpus (large / private); keep the small demo *.md samples tracked
data/corpus/*
!data/corpus/.gitkeep
!data/corpus/*.md

# Benchmark raw cache (bulk, re-fetchable); keep the small golden labels tracked
data/benchmark/_du_cache.json

# External benchmark repos (cloned on demand, not committed)
data/_ext/

# Logs / traces
logs/
*.log
logs_*.txt
.coverage

# OS
.DS_Store
Thumbs.db

# 运维备忘（含服务器 IP/服务清单，基础设施信息不外泄）
docs/服务器运维备忘.md

# 大轮子/本地下载产物（不入库）
_wheels/
*.whl

# 含密钥的部署脚本（绝不上库；实际 .env 在服务器端）
deploy/server_serve.sh
