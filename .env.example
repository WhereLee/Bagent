# ===== PostgreSQL / pgvector =====
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
# 真实密码请填入 .env（.env 已被 gitignore，不会提交）
PG_PASSWORD=
PG_DATABASE=bagent_rag

# ===== LLM: Xiaomi MiMo (OpenAI-compatible) =====
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.6-flash
# thinking=enabled|disabled：是否让 MiMo 输出推理链
MIMO_THINKING=disabled

# ===== Embedding (local, CPU) =====
# 权重缓存目录：强制落在项目目录，避免写入 C 盘
EMBEDDING_MODEL_NAME=bge-small-zh-v1.5
EMBEDDING_MODEL_PATH=./models
EMBEDDING_DIM=512
EMBEDDING_BATCH_SIZE=64

# ===== Retrieval =====
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_N=20

# ===== App =====
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
