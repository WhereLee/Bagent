# ===== PostgreSQL / pgvector =====
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
# 真实密码请填入 .env（.env 已被 gitignore，不会提交）
PG_PASSWORD=
PG_DATABASE=bagent_rag

# ===== LLM: Xiaomi MiMo (OpenAI-compatible) =====
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.6-flash
# thinking=enabled|disabled：是否让 MiMo 输出推理链
MIMO_THINKING=disabled

# ===== LLM: DeepSeek (OpenAI 兼容) =====
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# ===== LLM provider 路由与韧性 =====
# deepseek | mimo；fallback 置空则不降级
LLM_PRIMARY_PROVIDER=deepseek
LLM_FALLBACK_PROVIDER=mimo
LLM_TIMEOUT=15
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=0.5

# ===== Embedding (local, CPU) =====
# 权重缓存目录：强制落在项目目录，避免写入 C 盘
EMBEDDING_MODEL_NAME=bge-small-zh-v1.5
EMBEDDING_MODEL_PATH=./models
EMBEDDING_DIM=512
EMBEDDING_BATCH_SIZE=64

# ===== Retrieval =====
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_N=20
# dense(纯向量) / hybrid(向量+BM25, RRF 融合)
RETRIEVAL_MODE=hybrid
RRF_K=60
# 命中子块后扩展为父块内容喂给 LLM
RETRIEVE_PARENT=true

# ===== Chunking (父子块) =====
CHUNK_PARENT_TOKENS=600
CHUNK_CHILD_TOKENS=150
CHUNK_CHILD_OVERLAP=30

# ===== Rerank (Cross-Encoder) =====
RERANK_ENABLED=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
# 自适应精排：dense top1 分数高于此阈值则跳过 rerank（留空=关闭）
# RERANK_SKIP_THRESHOLD=0.9
# int8 动态量化：本机实测 ×2.4 快/体积−31%，质量 Δ 在 CI 内（见 scripts/eval_rerank_ab.py）
RERANKER_INT8=false
RERANK_THREADS=0
# ONNX 后端（推荐生产）：先跑 scripts/export_reranker_onnx.py 生成小模型
# backend=st|onnx；onnx 用 int8 时磁盘仅 ~279MB、mrr 与 fp32 持平（A/B 实测）
RERANKER_BACKEND=st
RERANKER_ONNX_PATH=models/reranker-onnx/model_int8.onnx

# ===== Generation / Evidence chain (M3) =====
FORCE_CITATION=true
FAITHFULNESS_THRESHOLD=0.6
REWRITE_ENABLED=true
FAITHFULNESS_ENABLED=true

# ===== Self-RAG / 知识冲突 (M8) =====
# 默认关（不静默改变现有行为/额外 LLM 调用成本）；按需开启
SELF_RAG_ENABLED=false
SELF_RAG_MAX_ITERS=2
CONFLICT_CHECK_ENABLED=true

# ===== App =====
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ===== Rate limit (M4) =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_SEC=5
RATE_LIMIT_BURST=10

# ===== Retrieval cache (M6) =====
RETRIEVAL_CACHE_ENABLED=true
RETRIEVAL_CACHE_MAX=256
RETRIEVAL_CACHE_TTL=300

# ===== Security (M6) =====
# 设置后 /query /search /ingest /chat 需带 X-API-Key 头
API_KEY=
PROMPT_INJECTION_GUARD=true

# ===== Multi-tenant 数据面强制 (⑥) =====
# 启用后除 /health /metrics /docs 外，每请求必须带签名头 X-Tenant: <tenant>|<hmac>
# （由 Java 管理面用同一 TENANT_SECRET 签发）；否则 403（fail-closed）。
TENANT_ENFORCEMENT_ENABLED=false
TENANT_SECRET=

# ===== Web search / 联网 (M9a) =====
# 默认关；开启后 self-RAG 可把联网作为多源佐证的又一路
WEB_SEARCH_ENABLED=false
# mock | searxng
SEARCH_PROVIDER=mock
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_ENGINES=sogou,360search
WEB_SEARCH_MAX_RESULTS=5
WEB_FETCH_FULLTEXT=true
WEB_CONTENT_MAX_CHARS=4000
SEARCH_MIN_INTERVAL=1.0
SEARCH_TIMEOUT=8

# ===== Memory / 写回记忆 (M9b) =====
# 默认关；开启后 /query /chat 传 user_id 会注入个人记忆上下文 + 后台写回
MEMORY_ENABLED=false
MEMORY_MIN_TRUST_FOR_ANSWER=verified   # 参与作答的最低 trust（draft 默认不作答）
MEMORY_PROMOTE_SUPPORT=2               # 佐证来源数≥此值促为 verified
MEMORY_DEDUP_SIM=0.92                  # 去重/更新的相似度阈值
MEMORY_CONTEXT_K=3
